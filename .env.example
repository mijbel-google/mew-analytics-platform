# =============================================================================
# MEW Energy Intelligence Platform - Environment Variables Template
# Copy this file to `.env` (which is gitignored) and fill in your values.
# =============================================================================

# GCP Project & Location
GCP_PROJECT_ID="your-gcp-project-id"
GCP_PROJECT_NUMBER="your-gcp-project-number"
GCP_LOCATION="europe-west4"

# BigQuery Dataset & Raw Tables
DATASET_NAME="mew_analytics"
DATASET_ID="mew_analytics"
GOLD_DATASET="mew_analytics"
RAW_POWER_STAT_TABLE="POWER_STAT"
RAW_GENERATOR_TABLE="GENERATOR_READINGS"

# BigQuery Conversational Analytics (Optional - leave empty to use Gemini SQL fallback)
BIGQUERY_DATA_AGENT_ID=""
BIGQUERY_DATA_AGENT_LOCATION="eu"

# Dataform & Pub/Sub
DATAFORM_REPO="mew-grid-pipeline"
DATAFORM_BRANCH="dataform"
PUBSUB_TOPIC="grid-stress-alerts"
SERVICE_ACCOUNT_NAME="mew-pipeline-sa"

# Managed Airflow Gen 3 (Cloud Composer 3)
COMPOSER_ENV_NAME="mew-airflow-env"
COMPOSER_IMAGE_VERSION="composer-3-airflow-3"
AIRFLOW_5MIN_DAG_ID="mew_5min_telemetry_inference_dag"
AIRFLOW_DAILY_DAG_ID="mew_daily_retrain_forecast_dag"

# Cloud Run Data App
SERVICE_NAME="mew-scada-intelligence-hub"
REPO_NAME="mew-data-apps"
